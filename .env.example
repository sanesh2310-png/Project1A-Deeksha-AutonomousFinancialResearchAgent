# Optional: if set, ARA-1 will attempt real LLM calls instead of the
# deterministic SimulatedPlanner (see agent/simulated_planner.py).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Agent loop control
MAX_ITERATIONS=12
MAX_TOOL_CALLS_PER_TASK=20

# Error handling
RETRY_INITIAL_DELAY_SECONDS=1.0
RETRY_MAX_ATTEMPTS=5
RETRY_JITTER_MS=500
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=10

# Memory
VECTOR_STORE_PATH=./memory/.vector_store.json
EPISODIC_STORE_PATH=./memory/.episodic_store.json
EMBEDDING_DIM=256

# Synthesis
CONFLICT_THRESHOLD_PCT=5.0

# Networking / mock mode -- set to false only in an environment with real
# outbound access to SEC EDGAR / financial data providers.
FORCE_MOCK_MODE=true
HTTP_TIMEOUT_SECONDS=6
